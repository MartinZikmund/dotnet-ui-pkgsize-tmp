<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AvaApp\AvaApp.csproj" />
  </ItemGroup>
  <!-- package-size harness: enables NativeAOT for this head only (a command-line PublishAot would also reach the class library) -->
  <PropertyGroup Condition="'$(HeadPublishAot)' == 'true'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>
</Project>
